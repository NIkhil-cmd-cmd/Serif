import Foundation

/// Copy to `MicrosoftCredentials.swift` (gitignored) and fill in from Azure Portal → App registrations.
///
/// **Redirect URIs (required or you get `AADSTS900971: No reply address provided.`)**
///
/// 1. Azure Portal → your app → **Authentication** → **Add a platform** → **Mobile and desktop applications**.
/// 2. Under **Redirect URIs**, add what matches how you sign in:
///    - **Loopback (default macOS):** **`http://localhost`** — Serif uses `http://localhost:<random port>/` when `macOSRedirectURI` is empty.
///    - **MSAL-style macOS (Azure “native” redirect):** e.g. **`msauth.com.your.bundle.id://auth`** — set the same string in `macOSRedirectURI` and add that URL **scheme** (substring before `:`) to macOS `CFBundleURLTypes` in `Info.plist`.
///    - **iOS:** **`com.serif.outlook.oauth://callback`** (must match `iOSRedirectURI` and your Xcode URL scheme).
/// 3. Save. If you use a **client secret**, keep “Allow public client flows” as needed for your app type; desktop confidential clients are common.
///
/// Do **not** rely only on `http://127.0.0.1` in Azure unless you register every port; the app normalizes to `localhost` for the OAuth `redirect_uri` parameter.
enum MicrosoftCredentials {
    static let tenant = "common"
    static let clientID = "YOUR_AZURE_CLIENT_ID"
    /// Required for confidential desktop flows. Use empty string only if you configure a public client with PKCE and no secret in Azure.
    static let clientSecret = "YOUR_CLIENT_SECRET_OR_EMPTY"

    /// Must match an entry in Azure and in iOS `CFBundleURLTypes` (scheme = substring before `:`).
    static let iOSRedirectURI = "com.serif.outlook.oauth://callback"

    /// macOS: empty = AppAuth loopback + `http://localhost` in Azure. Non-empty = PKCE + system browser (same pattern as iOS); must match Azure and `Info.plist` URL scheme.
    static let macOSRedirectURI = ""

    static let scopes = [
        "offline_access",
        "openid",
        "profile",
        "User.Read",
        "Mail.ReadWrite"
    ]
}
